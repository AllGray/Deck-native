+// SWITCH2 (private bring-up): the Switch 2 system counter runs at 31.25 MHz (Eden-NS2 guest_clock.h GetGuestCounterFrequency), the Tegra X1's at 19.2 MHz.
+// The SDK converts ticks with its constant, so the 19.2 MHz counter ran Pokopia's clock at 61.4 %: a 27.1 ms frame from its 60 fps limiter, animations 1.63x slow.
+// Every guest-visible counter (the cntpct / cntvct gate, svc GetSystemTick) comes from here. DM_TICK_HZ overrides (19200000 = the Tegra X1 counter).
+uint64_t guest_ticks(void) {
+    static uint64_t hz;
+    if (!hz) { const char *e = getenv("DM_TICK_HZ"); uint64_t v = e ? strtoull(e, 0, 0) : 31250000ull; if (!v) v = 31250000ull; hz = v;
+               LOG("guest system counter %llu Hz (%s)", (unsigned long long)hz, e ? "DM_TICK_HZ" : "Switch 2 default"); }
+    return (uint64_t)(((__uint128_t)guest_ns() * hz) / 1000000000ull);
+}
